# Vercel Preview Environment
# Set in Vercel Dashboard → Settings → Environment Variables → Preview → all branches
# NEVER commit real values to Git
#
# Template for PR preview deployments. Use Stripe **Test mode** keys here.
# Production values live in config/environments/prod.env.example

# =============================================================================
# ENVIRONMENT
# =============================================================================
NODE_ENV=production
ENVIRONMENT=preview
# VERCEL_ENV=preview is set automatically on Vercel Preview deployments

# =============================================================================
# DATABASE (isolated Neon Preview project; synthetic test data only)
# =============================================================================
# Preview uses apisandbox-preview / preview / apisandbox_preview, never Production.
# Store real connection strings as Preview secrets in Vercel; these are placeholders.
# Runtime: pooled Neon host (-pooler). Schema operations: unpooled host.
# lib/prisma-url.ts appends pgbouncer=true + connection_limit=1 for pooler hosts.
# Preview builds skip migrations. The historical SQLite-era migration chain is not
# replayable against this fresh PostgreSQL baseline: use reviewed incremental SQL.
# See docs/DEPLOYMENT.md and docs/NEON_PREVIEW_CLEANUP.md.
DATABASE_URL="postgresql://preview_owner:REPLACE_ME@ep-example-pooler.us-east-1.aws.neon.tech/apisandbox_preview?sslmode=require"
DIRECT_URL="postgresql://preview_owner:REPLACE_ME@ep-example.us-east-1.aws.neon.tech/apisandbox_preview?sslmode=require"

# =============================================================================
# AUTHENTICATION (REQUIRED on Preview — scope to all branches)
# =============================================================================
# Generate: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32"
NEXTAUTH_SECRET="CHANGE_ME_SAME_VALUE_AS_AUTH_SECRET"
AUTH_JWT_SECRET="CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32"

# Use the deployment URL for this preview (or a stable preview alias).
# Vercel also sets VERCEL_URL; the app falls back when NEXT_PUBLIC_APP_URL is unset.
NEXT_PUBLIC_APP_URL="https://your-preview-host.vercel.app"
AUTH_URL="https://your-preview-host.vercel.app"
NEXTAUTH_URL="https://your-preview-host.vercel.app"

# =============================================================================
# GOOGLE SIGN-IN
# =============================================================================
# Add each preview origin to Google Cloud → OAuth → Authorized JavaScript origins.
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# =============================================================================
# PREVIEW CHECKLIST
# =============================================================================
# 1. DATABASE_URL = Preview-scoped pooler URL (never Production Neon);
#    DIRECT_URL = unpooled Neon URL for approved schema operations
# 2. AUTH_SECRET + AUTH_JWT_SECRET (32+ chars; Preview → all branches)
# 3. GOOGLE_CLIENT_ID + add preview host to Google authorized origins
# 4. NEXT_PUBLIC_APP_URL matches the preview host under test
# 5. Schema: reviewed incremental PostgreSQL SQL (builds skip migrate deploy)
# 6. Smoke: curl https://<preview-host>/api/health/auth | jq .data.jwtSecretConfigured
# 7. Test users: docs/TEST_USERS.md (Preview section — do not assume local seeds exist)

# =============================================================================
# SAAS FEATURE FLAGS (preview — Stripe Test mode)
# =============================================================================
# Shared Preview baseline: configure Test keys + webhook signer for ALL Preview branches.
# See docs/PREVIEW_BILLING.md. Branch-specific overrides are exceptions.
NEXT_PUBLIC_FF_PREMIUM_PAYWALL=true
NEXT_PUBLIC_FF_STRIPE_CHECKOUT=true
NEXT_PUBLIC_FF_BILLING_PORTAL=false
NEXT_PUBLIC_FF_RATE_LIMITING=false
NEXT_PUBLIC_FF_DEMO_LOGIN=false
NEXT_PUBLIC_FF_ANALYTICS=false

# =============================================================================
# STRIPE BILLING (Test mode only on Preview)
# =============================================================================
# Use sk_test_... / price_... from Stripe Dashboard (Test mode).
# Webhook: https://<preview-host>/api/webhooks/stripe or Stripe CLI for local parity.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID="price_..."

# =============================================================================
# ASSISTANT (optional — Preview scope, server-only)
# =============================================================================
OPENAI_API_KEY=""
# GEMINI_API_KEY=""
# ASSISTANT_PROVIDER=""  # optional: openai | gemini (defaults to gemini when GEMINI_API_KEY is set)
# Learning assistant is Preview/local only — Production omits the widget and returns 404 from /api/assistant.

# =============================================================================
# RATE LIMITING (optional)
# =============================================================================
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional Phase 1 demo login (ephemeral users; see docs/TEST_USERS.md):
# NEXT_PUBLIC_FF_DEMO_LOGIN=true
# DEMO_USER_TTL_HOURS=24
